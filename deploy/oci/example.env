# earlier-stardew — production box configuration. Copy to .env and fill in; NEVER commit .env.

# Public IPv4 of this box (OCI: the reserved public IP, not the VNIC's private one).
PUBLIC_IP=203.0.113.10

# Production OpenPak account server. OPENPAK_SECRET must be IDENTICAL to the account
# server's (it proves the console's openpak claim); OPENPAK_INTERNAL_KEY lets this box, which is
# off the account server's internal network, call /internal/npln-friends.
OPENPAK_ACCOUNT_URL=archived external source
OPENPAK_SECRET=change-me
OPENPAK_INTERNAL_KEY=change-me

# Shared between the server (hands the game short-lived TURN credentials) and coturn.
NPLN_TURN_SECRET=change-me-random
