# stardew-valley — production box configuration. Copy to .env and fill in; NEVER commit .env.

# Public IPv4 of this box (OCI: the reserved public IP, not the VNIC's private one).
PUBLIC_IP=203.0.113.10

# nx-baas internal API (Openpak/ports.md: 20070) and its NX_INTERNAL_KEY (>=32 bytes). It proves
# the nnex claim and serves the friend graph; the NEX signing key never lives here.
NX_INTERNAL_URL=http://127.0.0.1:20070
NX_INTERNAL_KEY=change-me-change-me-change-me-change-me

# Shared between the server (hands the game short-lived TURN credentials) and coturn.
NPLN_TURN_SECRET=change-me-random
